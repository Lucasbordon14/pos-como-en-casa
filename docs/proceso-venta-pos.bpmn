<bpmn:lane id="Lane_Produccion" name="Producción"><bpmn:flowNodeRef>P1</bpmn:flowNodeRef><bpmn:flowNodeRef>P2</bpmn:flowNodeRef><bpmn:flowNodeRef>P3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Sistema" name="Sistema POS"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>S3</bpmn:flowNodeRef><bpmn:flowNodeRef>S4</bpmn:flowNodeRef><bpmn:flowNodeRef>Fin</bpmn:flowNodeRef></bpmn:lane>
