<bpmn:startEvent id="Inicio" name="Cliente realiza pedido"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_Inicio" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="J1" name=""><bpmn:incoming>F1</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F1b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T1" name="Registrar pedido en el celular"><bpmn:incoming>F1b</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="J2" name=""><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F2b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T2" name="Repetir el pedido al cliente"><bpmn:incoming>F2b</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="¿El cliente confirma?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T3" name="Modificar pedido"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
<bpmn:task id="T4" name="Confirmar comanda"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="S1" name="Registrar comanda y enviarla a cocina"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="P1" name="Marcar comanda en preparación"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
<bpmn:task id="P2" name="Preparar los productos"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
<bpmn:task id="P3" name="Marcar comanda como lista"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="S2" name="Notificar a la moza"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="T5" name="Retirar los productos de cocina"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
<bpmn:task id="T6" name="Entregar los productos en la mesa"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
<bpmn:task id="T7" name="Marcar comanda como entregada"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G2" name="¿El cliente pide algo más?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T8" name="Solicitar el total de la mesa"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="S3" name="Calcular total"><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:task id="T9" name="Informar el total y consultar el medio de pago"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G3" name="¿Medio de pago?"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T11" name="Indicar el alias"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:task>
<bpmn:task id="T10" name="Recibir efectivo y entregar vuelto"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="J3" name=""><bpmn:incoming>F23</bpmn:incoming><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F23b</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T12" name="Verificar la transferencia en el celular del cliente"><bpmn:incoming>F23b</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G4" name="¿El monto es correcto?"><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing><bpmn:outgoing>F26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T13" name="Solicitar la diferencia"><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G5" name=""><bpmn:incoming>F25</bpmn:incoming><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T14" name="Registrar cobro con el medio de pago"><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="S4" name="Marcar pedido como cobrado"><bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="Fin" name="Pedido cobrado"><bpmn:incoming>F31</bpmn:incoming></bpmn:endEvent>
